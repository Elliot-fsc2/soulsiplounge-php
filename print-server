<?php

/**
 * Local print agent for Soul Sip Lounge
 *
 * Usage on venue machine:
 *   php print-server start [--port=8080]
 *
 * This starts a lightweight HTTP server that receives print jobs
 * from the cloud VPS and sends them to the local thermal printer.
 */

use Mike42\Escpos\PrintConnectors\WindowsPrintConnector;
use Mike42\Escpos\PrintConnectors\NetworkPrintConnector;
use Mike42\Escpos\Printer;

require __DIR__ . '/vendor/autoload.php';

// Load .env if exists
if (file_exists(__DIR__ . '/.env')) {
    $lines = file(__DIR__ . '/.env', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        if (str_starts_with(trim($line), '#')) continue;
        putenv(trim($line));
    }
}

$command = $argv[1] ?? 'start';
$port = (int) ($argv[2] ?? getenv('PRINT_SERVER_PORT') ?: 8080);

if ($command === 'start') {
    echo "Starting print server on port $port...\n";
    echo "Printer: " . (getenv('PRINTER_INTERFACE') ?: 'windows') . " / " . (getenv('PRINTER_PORT') ?: 'ThermalPrinter') . "\n";
    echo "Press Ctrl+C to stop.\n\n";

    // Start PHP built-in server with this script as router
    $cmd = sprintf(
        'php -S 0.0.0.0:%d -t %s %s',
        $port,
        escapeshellarg(__DIR__ . '/public'),
        escapeshellarg(__FILE__)
    );
    passthru($cmd);
    exit;
}

// ─── Router mode (handles actual HTTP requests) ───

$method = $_SERVER['REQUEST_METHOD'];
$path = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);

// Serve static files for health check
if ($path === '/health') {
    http_response_code(200);
    echo json_encode(['status' => 'ok', 'printer' => getenv('PRINTER_PORT') ?: 'ThermalPrinter']);
    exit;
}

if ($method !== 'POST' || $path !== '/print') {
    http_response_code(404);
    echo json_encode(['error' => 'Not found']);
    exit;
}

$secret = getenv('PRINT_SERVER_SECRET');
$header = $_SERVER['HTTP_X_PRINT_SECRET'] ?? '';
if ($secret && $header !== $secret) {
    http_response_code(401);
    echo json_encode(['error' => 'Unauthorized']);
    exit;
}

$body = json_decode(file_get_contents('php://input'), true);

if (! $body) {
    http_response_code(400);
    echo json_encode(['error' => 'Invalid JSON']);
    exit;
}

try {
    $printerPort = getenv('PRINTER_PORT') ?: 'ThermalPrinter';
    $printerInterface = getenv('PRINTER_INTERFACE') ?: 'windows';
    $paperWidth = (int) (getenv('PRINTER_PAPER_WIDTH') ?: 58);

    $connector = match ($printerInterface) {
        'windows' => new WindowsPrintConnector($printerPort),
        'network' => new NetworkPrintConnector($printerPort),
        default => throw new InvalidArgumentException("Unknown interface: $printerInterface"),
    };

    $printer = new Printer($connector);
    $lineLen = $paperWidth === 58 ? 32 : 42;

    $printer->setJustification(Printer::JUSTIFY_CENTER);
    $printer->selectPrintMode(Printer::MODE_DOUBLE_HEIGHT);
    $printer->text("SOULSIPS LOUNGE\n");
    $printer->selectPrintMode();
    $printer->text("An elevated social lounge\n");
    $printer->feed();

    $printer->setJustification(Printer::JUSTIFY_LEFT);
    $printer->text(str_repeat('-', $lineLen) . "\n");
    $printer->text("{$body['invoice_number']}\n");
    $printer->text(date('M d, Y h:i A') . "\n");
    $printer->text("Staff: {$body['staff_name']}\n");

    if (! empty($body['room_name'])) {
        $printer->text("Room: {$body['room_name']}" . (! empty($body['guest_count']) ? " ({$body['guest_count']} pax)" : '') . "\n");
    }

    $printer->text(str_repeat('-', $lineLen) . "\n");

    foreach ($body['items'] as $item) {
        $line = $item['product_name'];
        $price = number_format($item['subtotal']);
        $spaces = max(1, $lineLen - strlen($line) - strlen($price));
        $printer->text("{$line}" . str_repeat(' ', $spaces) . "{$price}\n");

        if (($item['quantity'] ?? 1) > 1) {
            $printer->text("  x{$item['quantity']} @ " . number_format($item['product_price']) . "\n");
        }
    }

    $printer->text(str_repeat('-', $lineLen) . "\n");
    $printer->setEmphasis(true);
    $label = 'TOTAL';
    $total = number_format($body['total']);
    $spaces = max(1, $lineLen - strlen($label) - strlen($total));
    $printer->text("{$label}" . str_repeat(' ', $spaces) . "{$total}\n");
    $printer->setEmphasis(false);

    if (! empty($body['payment_method'])) {
        $printer->text('Payment: ' . strtoupper($body['payment_method']) . "\n");
    }

    if (! empty($body['amount_tendered'])) {
        $tendered = number_format($body['amount_tendered'] / 100, 2);
        $printer->text("Cash: {$tendered}\n");
    }

    if (isset($body['change'])) {
        $change = number_format($body['change'] / 100, 2);
        $printer->text("Change: {$change}\n");
    }

    $printer->feed(2);
    $printer->setJustification(Printer::JUSTIFY_CENTER);
    $printer->text("Thank you!\n");
    $printer->text("Visit again :)\n");
    $printer->feed(3);
    $printer->cut();
    $printer->close();

    http_response_code(200);
    echo json_encode(['success' => true]);
} catch (Throwable $e) {
    file_put_contents(__DIR__ . '/print-server-error.log', '[' . date('c') . '] ' . $e->getMessage() . PHP_EOL, FILE_APPEND);

    http_response_code(500);
    echo json_encode(['error' => $e->getMessage()]);
}
